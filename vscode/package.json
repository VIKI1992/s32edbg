{
  "name": "s32e-debug",
  "displayName": "S32E Debug",
  "description": "Debug NXP S32E27x boards over J-Link using the s32edbg backend: run control, RAM load, breakpoints, disassembly for 4x Cortex-R52 + 3x Cortex-M33, plus BSDL-named boundary scan.",
  "version": "0.3.2",
  "publisher": "s32e-tools",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "s32eDebug",
          "title": "S32E Debug",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "s32eDebug": [
        {
          "id": "s32e.session",
          "name": "Session",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.cores",
          "name": "Cores",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.variables",
          "name": "Variables",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.callStack",
          "name": "Call Stack",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.registers",
          "name": "Registers",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.breakpoints",
          "name": "Breakpoints",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.watchpoints",
          "name": "Watchpoints",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.memory",
          "name": "Memory",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.stacks",
          "name": "Stacks",
          "icon": "media/icon.svg"
        },
        {
          "id": "s32e.bscan",
          "name": "Boundary Scan",
          "icon": "media/icon.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "s32e.session",
        "contents": "Not connected to the board.\n[Connect](command:s32e.connect)\nConnecting opens one persistent J-Link session (each fresh connect pulses the board's reset line, so the session stays open until you disconnect).\nBoard misbehaving? Run diagnostics first:\n[Doctor](command:s32e.doctor) · [Probe info](command:s32e.probe)",
        "when": "!s32e.connected"
      },
      {
        "view": "s32e.cores",
        "contents": "Connect to discover cores.",
        "when": "!s32e.connected"
      },
      {
        "view": "s32e.bscan",
        "contents": "Boundary scan runs without a debug session: its preamble changes the JTAG chain and takes the DAP away until the board is power-cycled, so it goes last.\nDisconnect, then press ⟳ to sample every pin.",
        "when": "s32e.connected"
      }
    ],
