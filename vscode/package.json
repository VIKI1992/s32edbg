        },
        {
          "command": "s32e.sampleCore",
          "when": "view == s32e.cores && viewItem =~ /running/",
          "group": "1_control@5"
        },
        {
          "command": "s32e.removeBreakpoint",
          "when": "view == s32e.breakpoints && viewItem == breakpoint",
          "group": "inline@1"
        },
        {
          "command": "s32e.retargetBreakpoint",
          "when": "view == s32e.breakpoints && viewItem == breakpoint",
          "group": "1_edit@1"
        },
        {
          "command": "s32e.duplicateBreakpoint",
          "when": "view == s32e.breakpoints && viewItem == breakpoint",
          "group": "1_edit@2"
        },
        {
          "command": "s32e.clearOrphanComparator",
          "when": "view == s32e.breakpoints && viewItem == hwOrphanBp",
          "group": "1_edit@1"
        },
        {
          "command": "s32e.clearOrphanComparator",
          "when": "view == s32e.watchpoints && viewItem == hwOrphanWp",
          "group": "1_edit@1"
        },
        {
          "command": "s32e.removeWatchpoint",
          "when": "view == s32e.watchpoints && viewItem == watchpoint",
          "group": "inline@1"
        },
        {
          "command": "s32e.editRegister",
          "when": "view == s32e.registers && viewItem == register",
          "group": "inline@1"
        },
        {
          "command": "s32e.editVariable",
          "when": "view == s32e.variables && viewItem =~ /editable/",
          "group": "inline@1"
        },
        {
          "command": "s32e.plotVariable",
          "when": "view == s32e.variables && viewItem =~ /variable/",
          "group": "inline@3"
        },
        {
          "command": "s32e.removeWatch",
          "when": "view == s32e.variables && viewItem =~ /watchRoot/",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "s32e.runToCursor",
          "when": "s32e.connected && s32e.focusHalted && resourceScheme == file",
          "group": "s32e@1"
        },
        {
          "command": "s32e.addToWatchFromSelection",
          "when": "s32e.connected && editorHasSelection && resourceScheme == file",
          "group": "s32e@3"
        },
        {
          "command": "s32e.toggleDisasmBreakpoint",
          "when": "resourceScheme == s32e-disasm",
          "group": "s32e@1"
        },
        {
          "command": "s32e.runToCursor",
          "when": "s32e.connected && s32e.focusHalted && resourceScheme == s32e-disasm",
          "group": "s32e@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "s32e.continue",
        "key": "f5",
        "when": "s32e.connected && s32e.focusHalted && !inDebugMode"
      },
      {
        "command": "s32e.halt",
        "key": "f6",
        "when": "s32e.connected && !s32e.focusHalted && !inDebugMode"
      },
      {
        "command": "s32e.stepLineOver",
        "key": "f10",
        "when": "s32e.connected && s32e.focusHalted && !inDebugMode"
      },
      {
        "command": "s32e.stepLineIn",
        "key": "f11",
        "when": "s32e.connected && s32e.focusHalted && !inDebugMode"
      },
      {
        "command": "s32e.stepOut",
        "key": "shift+f11",
        "when": "s32e.connected && s32e.focusHalted && !inDebugMode"
      },
      {
        "command": "s32e.stepInstrOver",
        "key": "alt+f10",
        "when": "s32e.connected && s32e.focusHalted && !inDebugMode"
      },
      {
        "command": "s32e.stepInstrIn",
        "key": "alt+f11",
        "when": "s32e.connected && s32e.focusHalted && !inDebugMode"
      }
    ],
    "colors": [
      {
        "id": "s32e.pcLineBackground",
        "description": "Background of the line the focused core's PC is at",
        "defaults": {
          "dark": "#ffff0026",
          "light": "#ffff6633",
          "highContrast": "#ffff0026",
          "highContrastLight": "#ffff6633"
        }
      }
    ],
    "configuration": {
      "title": "S32E Debug",
      "properties": {
        "s32e.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 3.11+ (64-bit) interpreter with s32edbg installed (pip install -e <repo>[ide])."
        },
        "s32e.jlinkDir": {
          "type": "string",
          "default": "",
          "description": "SEGGER J-Link install directory (empty = auto-discover)."
        },
        "s32e.serial": {
          "type": "string",
          "default": "",
          "description": "J-Link probe serial number (empty = auto)."
        },
        "s32e.speedKhz": {
          "type": "number",
          "default": 16000,
          "description": "JTAG speed in kHz. 16000 is bench-proven on the S32E277 SOM; the tool's own default is 4000."
        },
        "s32e.device": {
          "type": "string",
          "default": "CORTEX-R52",
          "description": "J-Link device name passed to the backend. Must never be empty (an empty device wedges the probe until board power-cycle)."
        },
        "s32e.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "description": "Core-status poll interval while connected (0 disables polling; views then refresh only on your actions). Breakpoint hits are pushed by the backend within ~50 ms regardless -- this poll is the liveness sweep and fallback, so it can be slow."
        },
        "s32e.confirmDestructive": {
          "type": "boolean",
          "default": true,
          "description": "Ask before actions that reset the whole SoC (Load to RAM, Reset and Halt) or write memory."
        },
        "s32e.maxStackFrames": {
          "type": "number",
          "default": 32,
          "description": "Maximum call-stack frames to unwind."
        },
        "s32e.disasm.before": {
          "type": "number",
          "default": 32,
          "description": "Instructions to disassemble before the anchor address."
        },
        "s32e.disasm.after": {
          "type": "number",
          "default": 96,
          "description": "Instructions to disassemble after the anchor address."
        },
        "s32e.memory.defaultAp": {
          "type": "string",
          "default": "axi",
          "enum": ["axi", "apb", "mdm", "sda", "ahb-smu", "ahb-ce0", "ahb-ce1", "ahb-r0", "ahb-r1"],
          "description": "Default access port for the memory viewer. axi sees RAM; it is unreachable while functional reset is asserted."
        },
        "s32e.load.verifyFull": {
          "type": "boolean",
          "default": false,
          "description": "Full word-for-word verify after Load to RAM (sampled verification always runs)."
        },
        "s32e.stacks.fillPattern": {
          "type": "string",
          "default": "0xAAAAAAAA",
          "description": "The 32-bit word the OS paints unused stack with (MICROSAR OS_HAL_STACK_FILL_PATTERN). The Stacks view's utilization scan looks for where this pattern ends."
        },
        "s32e.bscan.bsdlPath": {
          "type": "string",
          "default": "",
          "description": "Path to a .bsdl file for boundary-scan pin names. Empty uses the BSDL bundled with the backend (SIP_S32E277 27x27, auto-selected by the probed JTAG IDCODE)."
        },
        "s32e.bscan.reverseCells": {
          "type": "boolean",
          "default": false,
          "description": "Decode boundary-scan captures with reversed cell orientation. Bench escape hatch: leave off unless sampled pins land on obviously wrong names (see the test plan's boundary-scan section)."
        },
        "s32e.variables.liveRefreshMs": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "Refresh interval for Globals/Watch while the focused core RUNS (0 disables live refresh). Locals refresh only on halt."
        },
        "s32e.comparators.verifyMs": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "description": "How often the hardware breakpoint/watchpoint comparators are read back and reconciled against this session's lists (0 disables; the Breakpoints/Watchpoints Auto-refresh checkboxes gate it per view). One pass also runs after every stop."
        },
        "s32e.plot.sampleHz": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "Initial TOTAL streaming rate for the scope (samples/s shared across all plotted signals; backend `var sample` streaming). The panel shows the achieved rate; the wire tops out near ~500/s for one signal."
        },
        "s32e.variables.childrenCap": {
          "type": "number",
          "default": 100,
          "description": "Children per expansion (array page size) and the globals page size."
        },
        "s32e.load.core1": {
          "type": "string",
          "default": "leave",
          "enum": ["leave", "park", "release"],
          "enumDescriptions": [
            "Leave rtu0.1 untouched (core0 firmware brings it up itself)",
            "Bring rtu0.1 up halted at the entry",
            "Bring rtu0.1 up free-running"
          ],
          "description": "rtu0.1 handling after Load to RAM."
        }
      }
    }
  }
}
