      "view/item/context": [
        {
          "command": "s32e.bscan.driveHigh",
          "when": "view == s32e.bscan && !s32e.connected && viewItem =~ /bscanPin/",
          "group": "drive@1"
        },
        {
          "command": "s32e.bscan.driveLow",
          "when": "view == s32e.bscan && !s32e.connected && viewItem =~ /bscanPin/",
          "group": "drive@2"
        },
        {
          "command": "s32e.bscan.driveZ",
          "when": "view == s32e.bscan && !s32e.connected && viewItem =~ /bscanPin/",
          "group": "drive@3"
        },
        {
          "command": "s32e.bscan.stopDriving",
          "when": "view == s32e.bscan && !s32e.connected && viewItem == bscanPinDriven",
          "group": "drive@4"
        },
        {
          "command": "s32e.focusCore",
          "when": "view == s32e.cores && viewItem =~ /core/",
          "group": "inline@1"
        },
        {
          "command": "s32e.haltCore",
          "when": "view == s32e.cores && viewItem =~ /running/",
          "group": "inline@2"
        },
        {
          "command": "s32e.resumeCore",
          "when": "view == s32e.cores && viewItem =~ /halted/",
          "group": "inline@2"
        },
        {
          "command": "s32e.stepLineIn",
          "when": "view == s32e.cores && viewItem =~ /halted/",
          "group": "inline@3"
        },
        {
          "command": "s32e.stepLineOver",
          "when": "view == s32e.cores && viewItem =~ /halted/",
          "group": "inline@4"
        },
        {
          "command": "s32e.stepInstrIn",
          "when": "view == s32e.cores && viewItem =~ /halted/",
          "group": "inline@5"
        },
        {
          "command": "s32e.openDisasm",
